# App
PORT=3000
NODE_ENV=development

# Database (host port matches docker-compose.yml's POSTGRES_PORT)
DATABASE_URL=postgresql://mapeador:mapeador@localhost:5433/mapeador_editais?schema=public
# Used only by the Prisma CLI for migrations (needs PostGIS pre-enabled; the main dev DB has it via the postgis/postgis image's template, a fresh shadow DB would not)
SHADOW_DATABASE_URL=postgresql://mapeador:mapeador@localhost:5433/mapeador_editais_shadow?schema=public

# Redis / BullMQ (host port matches docker-compose.yml's REDIS_PORT)
REDIS_HOST=localhost
REDIS_PORT=6380

# CORS (comma-separated list of allowed origins)
# In production (backend still runs locally, exposed via ngrok), add the real
# Vercel frontend domain here alongside the local dev origin, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://your-project.vercel.app
CORS_ORIGINS=http://localhost:5173

# Local document storage (relative to backend/ or an absolute path)
STORAGE_LOCAL_DIR=uploads

# AI-based structured extraction (ai-analysis module)
# Provider currently implemented: "gemini". "openai" is accepted by config but has no
# implementation yet - swapping providers only requires adding a new AiProvider, not
# changing business logic.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_MAX_INPUT_CHARS=24000

# Google AI Studio API key (free tier), used by the default "gemini" provider
GOOGLE_AI_API_KEY=AI...

# OpenAI API key, kept as an alternative provider (not used by default, to avoid cost)
OPEN_AI_API_KEY=sk-...
