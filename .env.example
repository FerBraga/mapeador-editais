# Postgres / Docker Compose
POSTGRES_USER=mapeador
POSTGRES_PASSWORD=mapeador
POSTGRES_DB=mapeador_editais
# Host port mapped to the container's 5432 - adjust if it collides with another local Postgres
POSTGRES_PORT=5433

# Redis / Docker Compose
# Host port mapped to the container's 6379 - adjust if it collides with another local Redis
REDIS_PORT=6380

# ngrok (used by scripts/start-local-backend.sh to expose the local backend)
# Reserve a free fixed domain in the ngrok dashboard first; see DEPLOY.md.
NGROK_DOMAIN=your-reserved-domain.ngrok-free.app
